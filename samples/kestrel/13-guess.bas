10 REM *** THE MACHINE GUESSES A NUMBER
20 T=730
30 L=1:H=1000:N=0
40 IF L>H THEN 200
50 G=INT((L+H)/2)
60 N=N+1
70 PRINT "GUESS ";N;" IS ";G
80 IF G=T THEN 150
90 IF G<T THEN 120
100 H=G-1
110 GOTO 40
120 L=G+1
130 GOTO 40
150 PRINT "FOUND ";T;" IN ";N;" TRIES"
160 END
200 PRINT "NOT IN THE RANGE"
