10 REM *** INVOICE WITH VAT
20 T=0
30 PRINT "ITEM","QTY","AMOUNT"
40 FOR I=1 TO 4
50 READ N$,Q,P
60 L=INT(Q*P*100+0.5)/100
70 T=T+L
80 PRINT N$,Q,L
90 NEXT I
100 V=INT(T*17.5+0.5)/100
110 PRINT
120 PRINT "NET",T
130 PRINT "VAT",V
140 PRINT "TOTAL",T+V
150 DATA "BOLTS",10,0.25
160 DATA "NUTS",20,0.1
170 DATA "WASHERS",50,0.02
180 DATA "CABLE",3,1.75
