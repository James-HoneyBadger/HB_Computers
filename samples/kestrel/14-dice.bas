10 REM *** TWO DICE, ONE HUNDRED THROWS
20 DIM C(12)
30 S=0
40 FOR I=1 TO 100
50 A=INT(RND(1)*6)+1
60 B=INT(RND(1)*6)+1
70 C(A+B)=C(A+B)+1
80 NEXT I
90 PRINT "TOTAL COUNT"
100 FOR I=2 TO 12
110 PRINT "TOTAL ";I;" ";C(I);" ";
120 FOR J=1 TO C(I)/4
130 PRINT "*";
140 NEXT J
150 PRINT
160 S=S+C(I)
170 NEXT I
180 PRINT "THROWS ";S
