10 REM *** MEAN AND STANDARD DEVIATION
20 DIM D(9)
30 S=0
40 FOR I=1 TO 9
50 READ D(I)
60 S=S+D(I)
70 NEXT I
80 M=S/9
90 V=0
100 FOR I=1 TO 9
110 V=V+(D(I)-M)*(D(I)-M)
120 NEXT I
130 PRINT "COUNT",9
140 PRINT "MEAN",INT(M*100+0.5)/100
150 PRINT "SD",INT(SQR(V/9)*1000+0.5)/1000
160 DATA 12,15,11,18,14,13,16,10,17
