10 REM *** HANGMAN, THE MACHINE PLAYS BOTH PARTS
20 W$="KESTREL"
30 G$="AEIOULNRST"
40 F=0
50 FOR K=1 TO LEN(G$)
60 C$=MID$(G$,K,1)
70 N=0
80 FOR I=1 TO LEN(W$)
90 IF MID$(W$,I,1)=C$ THEN N=N+1
100 NEXT I
110 IF N=0 THEN 160
120 F=F+N
130 PRINT C$;" HIT ";N;" TIMES"
140 PRINT "LETTERS ";F;" OF ";LEN(W$)
150 PRINT
160 NEXT K
170 PRINT "THE WORD IS ";W$
