10 REM *** CONWAY'S LIFE, SIX BY SIX
20 DIM A(99),B(99)
30 A(13)=1:A(23)=1:A(33)=1
40 A(55)=1:A(56)=1:A(65)=1:A(66)=1
50 FOR G=1 TO 2
60 PRINT "GEN ";G
70 FOR Y=1 TO 6
80 FOR X=1 TO 6
90 P=Y*10+X
100 IF A(P)=0 THEN PRINT ".";
110 IF A(P)=1 THEN PRINT "#";
120 N=A(P-11)+A(P-10)+A(P-9)+A(P-1)+A(P+1)+A(P+9)+A(P+10)+A(P+11)
130 B(P)=0
140 IF N=3 THEN B(P)=1
150 IF N=2 AND A(P)=1 THEN B(P)=1
160 NEXT X
170 PRINT
180 NEXT Y
190 FOR K=11 TO 66
200 A(K)=B(K)
210 NEXT K
220 NEXT G
