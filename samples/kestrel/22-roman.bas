10 REM *** ROMAN NUMERALS
20 DIM V(13)
30 FOR K=1 TO 13
40 READ V(K)
50 NEXT K
60 L$="MDCLXVI"
70 FOR I=1 TO 6
80 READ N
90 PRINT N;" = ";
100 R=N
110 FOR K=1 TO 13
120 IF R<V(K) THEN 200
130 IF K-2*INT(K/2)=0 THEN 160
140 PRINT MID$(L$,(K+1)/2,1);
150 GOTO 190
160 J=K/2
170 PRINT MID$(L$,2*INT((J+1)/2)+1,1);MID$(L$,J,1);
190 R=R-V(K)
195 GOTO 120
200 NEXT K
210 PRINT
220 NEXT I
230 DATA 1000,900,500,400,100,90,50,40,10,9,5,4,1
240 DATA 1984,49,2024,9,444,3999
