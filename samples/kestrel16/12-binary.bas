10 REM *** DECIMAL TO BINARY AND HEX
20 DIM N(5)
30 N(1)=5:N(2)=26:N(3)=101:N(4)=255:N(5)=1992
40 H$="0123456789ABCDEF"
50 FOR K=1 TO 5
60 M=N(K):B$=""
70 R=M-M/2*2
80 B$=STR$(R)+B$
90 M=M/2
100 IF M>0 THEN 70
110 X$="":M=N(K)
120 D=M-M/16*16
130 X$=MID$(H$,D+1,1)+X$
140 M=M/16
150 IF M>0 THEN 120
160 PRINT N(K);" BINARY ";B$;" HEX ";X$
170 NEXT K
RUN
