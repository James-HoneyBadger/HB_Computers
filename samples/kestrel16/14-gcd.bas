10 REM *** EUCLID'S ALGORITHM AND THE LCM
20 DIM A(5)
22 DIM B(5)
30 A(1)=12:B(1)=18
40 A(2)=100:B(2)=75
50 A(3)=17:B(3)=5
60 A(4)=270:B(4)=192
70 A(5)=1000:B(5)=625
80 PRINT "A     B     GCD   LCM"
90 FOR I=1 TO 5
100 X=A(I):Y=B(I)
110 IF Y=0 THEN 140
120 R=X-X/Y*Y
130 X=Y:Y=R:GOTO 110
140 PRINT A(I);"   ";B(I);"   ";X;"   ";A(I)/X*B(I)
150 NEXT I
RUN
