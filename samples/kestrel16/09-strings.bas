10 A$="KESTREL"
20 PRINT "WORD ";A$
30 PRINT "LENGTH ";LEN(A$)
40 B$=A$
50 IF B$="KESTREL" THEN PRINT "THE SAME"
60 IF B$<"KESTREL2" THEN PRINT "SHORTER IS LESS"
70 PRINT A$="OTHER"
80 PRINT "AND ";A$;" AGAIN"
90 PRINT "LEFT ";LEFT$(A$,3);" RIGHT ";RIGHT$(A$,3)
100 PRINT "MIDDLE ";MID$(A$,3,3)
110 C$="AB"+"CD"+"EF"
120 PRINT "JOINED ";C$;" ";LEN(C$)
130 PRINT "LETTERS ";CHR$(75);CHR$(69);CHR$(83);" ";ASC(A$)
RUN
