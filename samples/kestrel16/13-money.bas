10 REM *** INVOICE IN PENCE, WITH VAT
20 DIM Q(4)
30 DIM C(4)
40 Q(1)=10:C(1)=25
50 Q(2)=20:C(2)=10
60 Q(3)=50:C(3)=2
70 Q(4)=3:C(4)=175
80 T=0
90 PRINT "LINE QTY PENCE"
100 FOR I=1 TO 4
110 L=Q(I)*C(I):T=T+L
120 PRINT I;"    ";Q(I);"   ";L
130 NEXT I
140 V=(T*7+20)/40:G=T+V
150 W=T:GOSUB 300:PRINT "NET   ";F$
160 W=V:GOSUB 300:PRINT "VAT   ";F$
170 W=G:GOSUB 300:PRINT "GROSS ";F$
180 END
300 H=W/100:R=W-H*100
310 P$=STR$(R)
320 IF R<10 THEN P$="0"+P$
330 F$=STR$(H)+"."+P$
340 RETURN
RUN
